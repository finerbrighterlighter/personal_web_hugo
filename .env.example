# Local environment for `dotenv run ...`
#
# Keep local Hugo aligned with Netlify's HUGO_VERSION from netlify.toml.
# Example for Hugo 0.157.0 installed at ~/.local/hugo-0.157.0/hugo:
# PATH=/home/finer/.local/hugo-0.157.0:$PATH

# API keys used by live panels (optional for local dev)
HUGO_UNSPLASH_KEY=your_unsplash_key
HUGO_TRAKT_KEY=your_trakt_key
HUGO_TMDB_KEY=your_tmdb_key
HUGO_LASTFM_KEY=your_lastfm_key