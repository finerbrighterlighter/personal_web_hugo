  {{ if $papers -}}
### {{ replace ($cat | title) "-" " " }}

{{ range sort $papers "Date" "desc" -}}
{{- $src := slice -}}{{- with .Params.sources }}{{- $src = . -}}{{- end -}}
{{- $ft     := index (where $src "text" "fulltext") 0 -}}
{{- $pm     := index (where $src "text" "pubmed")   0 -}}
{{- $poster := index (where $src "text" "poster")   0 -}}
{{- $mirror := index (where $src "text" "mirror")   0 -}}
{{- $url := .Permalink -}}
{{- with $ft     }}{{- $url = .url -}}{{- else -}}
  {{- with $pm     }}{{- $url = .url -}}{{- else -}}
    {{- with $poster }}{{- $url = .url -}}{{- else -}}
      {{- with $mirror }}{{- $url = .url | absURL -}}{{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
- [{{ .Title }}]({{ $url }}): {{ with .Params.venue }}{{ . }}, {{ end }}{{ .Date.Format "2006" }}.{{ with .Plain }} {{ . }}{{ end }}
{{ end }}
